# --- Server Configuration ---------------------------------------------------
PORT=3007
NODE_ENV=development
PRODUCTION_URL=https://comercyo-back-create-sale-order.vercel.app

# --- CORS Configuration ------------------------------------------------------
# En producción, especifica los orígenes permitidos separados por coma
# Ejemplo: CORS_ORIGIN=https://miapp.com,https://www.miapp.com
CORS_ORIGIN=*

# --- Auth Configuration -------------------------------------------------------
# Access tokens are issued by the separate Comercyo users/auth backend
# (comercyo-back-users). This backend only verifies them - signature,
# expiry, and audience (JWT_AUDIENCE) - it never touches sessions or
# refresh tokens itself.
JWT_SECRET=                          # long random secret, HS256, same value the auth backend signs with
JWT_AUDIENCE=comercyo-internal       # must equal comercyo-back-users' JWT_AUDIENCE

# --- Database (Supabase Postgres pooler) -------------------------------------
# supabase-tiendas project ref - holds users/sessions and the Inventario
# tables (customers, productos, sales_orders, etc.).
TIENDAS_DB_REF=jzjgdcnlvfosvnjhssiv

# Combined as ${DATABASE_BASE}${TIENDAS_DB_REF}${DATABASE_PASSWORD}${DATABASE_HOST}
# (see src/config/db.ts). Get these from Supabase -> Project Settings ->
# Database -> Connection Pooling (mode "Transaction", port 6543).
DATABASE_BASE=postgresql://postgres.
DATABASE_PASSWORD=                   # pooler connection password, not your account password
DATABASE_HOST=                       # e.g. @aws-0-us-east-1.pooler.supabase.com:6543/postgres
